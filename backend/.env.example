# Copy to .env and adjust. python-dotenv loads this automatically.
#
# Unset DATABASE_URL  -> zero-config on-disk SQLite (backend/instance/remy.db).
# Set it              -> Postgres/Supabase, isolated in its own schema.

# --- Postgres / shared Supabase ---------------------------------------------
# Use the SUPABASE SESSION POOLER host (port :5432). Schema isolation pins
# search_path per connection, which a transaction-mode pooler would drop.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# The schema (namespace) remy's tables live in. Default: public.
# Give remy its own so it can share one database with other apps, collision-free.
# DB_SCHEMA=remy

# Set to "disable" only for a local plaintext Postgres (Supabase needs TLS).
# DATABASE_SSL=disable

# Max pooled connections — keep small behind the pooler / free tier (default 3).
# PGPOOL_MAX=3

# --- dev server --------------------------------------------------------------
# PORT=5000
