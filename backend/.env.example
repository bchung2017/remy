# Copy to .env and adjust. python-dotenv loads this automatically.
#
# Unset DATABASE_URL  -> zero-config on-disk SQLite (backend/instance/remy.db).
# Set it              -> Postgres/Supabase, isolated in its own schema.

# --- Postgres / shared Supabase ---------------------------------------------
# Use the SUPABASE SESSION POOLER host (port :5432). Schema isolation pins
# search_path per connection, which a transaction-mode pooler would drop.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# The schema (namespace) remy's tables live in. Default: public.
# Give remy its own so it can share one database with other apps, collision-free.
# DB_SCHEMA=remy

# Set to "disable" only for a local plaintext Postgres (Supabase needs TLS).
# DATABASE_SSL=disable

# Max pooled connections — keep small behind the pooler / free tier (default 3).
# PGPOOL_MAX=3

# --- dev server --------------------------------------------------------------
# PORT=5000

# --- AI cell (Claude) --------------------------------------------------------
# Set to enable the AI cell: the browser dictates, claude-haiku-5-5 formats.
# Unset -> POST /api/recipes/draft returns 503 and "+ AI" is disabled.
# ANTHROPIC_API_KEY=sk-ant-...


# --- AI cell: speech-to-text (Groq Whisper) -----------------------------------
# Recorded chunks are transcribed by whisper-large-v3-turbo on Groq, about
# $0.04 per hour of audio. Unset -> POST /api/transcribe returns 503 and the
# Dictate button is disabled (typing into the AI cell still works).
# GROQ_API_KEY=gsk_...
# STT_MODEL=whisper-large-v3-turbo

# --- Video cell (YouTube captions) --------------------------------------------
# No key needed. YouTube blocks many cloud IPs; if the video cell reports
# "YouTube is blocking this server", route through an http(s) proxy:
# YOUTUBE_PROXY_URL=http://user:pass@proxy.example:8080
